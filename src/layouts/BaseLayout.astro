---
interface Props {
  title?: string;
}

const {title = "Priyan Arora | Software Engineer"} = Astro.props;
const description = "Priyan Arora is a computer science student and software developer in Fredericton, New Brunswick, building projects with React, Astro, Next.js, TypeScript, Java, Node.js, Spring Boot, D3.js, GIS, AWS, and Supabase.";
const keywords = [
  "Priyan Arora",
  "Priyan Arora portfolio",
  "software engineer Fredericton",
  "software developer Fredericton",
  "co-op Fredericton",
  "software developer co-op Fredericton",
  "Atlantic software engineer",
  "Atlantic Canada software engineer",
  "Atlantic software developer",
  "New Brunswick software developer",
  "University of New Brunswick computer science",
  "UNB computer science",
  "PRPilot",
  "Auctus",
  "D3Careers",
  "BSI Solutionz",
  "EVLOS-OPS",
  "Likit",
  "React",
  "Astro",
  "Next.js",
  "TypeScript",
  "JavaScript",
  "Java",
  "Node.js",
  "Express",
  "Spring Boot",
  "D3.js",
  "Tailwind CSS",
  "GSAP",
  "MongoDB",
  "PostgreSQL",
  "Supabase",
  "DynamoDB",
  "AWS Lambda",
  "API Gateway",
  "SQS",
  "Docker",
  "GitHub Actions",
  "ArcGIS",
  "GIS developer",
].join(", ");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="Priyan Arora" />
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Priyan Arora Portfolio" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <title>{title}</title>                                                                                                                                                    
    </head>                                                                                                                                                                     
    <body>                                                                                                                                                                      
        <slot />                                                                                                                                                                  
    </body>       
</html>                                                                                                                                                                       
                  
<style is:global>
    @import '../styles/global.css';
</style>     
