---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, status, tags, repoUrl, liveUrl } = project.data;
---

<BaseLayout title={`${title} | Priyan Arora`}>
    <main class="min-h-screen max-w-screen-2xl mx-auto px-6 lg:px-16 py-12 lg:py-20">
        <a href="/#work" class="font-mono text-sm no-underline opacity-60 hover:opacity-100">Back to Work</a>

        <header class="mt-12 lg:mt-20 max-w-5xl">
            <p class="font-mono text-sm opacity-60 mb-4">{status}</p>
            <h1 class="font-sans text-4xl xs:text-5xl md:text-6xl lg:text-7xl leading-none tracking-tight">{title}</h1>
            <p class="font-sans text-xl md:text-2xl opacity-70 mt-6 max-w-3xl">{description}</p>

            <div class="flex flex-wrap gap-2 mt-8">
                {tags.map((tag) => (
                    <span class="font-mono text-xs border border-white/30 rounded-full px-3 py-1">{tag}</span>
                ))}
            </div>

            {(liveUrl || repoUrl) && (
                <div class="flex gap-4 mt-8 font-mono text-sm">
                    {liveUrl && <a href={liveUrl}>Live</a>}
                    {repoUrl && <a href={repoUrl}>Repo</a>}
                </div>
            )}
        </header>

        <article class="project-body mt-16 lg:mt-24 max-w-4xl">
            <slot />
        </article>
    </main>
</BaseLayout>

<script>
    import mermaid from 'mermaid';

    mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        securityLevel: 'strict',
        themeVariables: {
            background: 'transparent',
            mainBkg: '#1e40af',
            secondBkg: '#1e3a8a',
            primaryColor: '#1e40af',
            primaryTextColor: '#ffffff',
            primaryBorderColor: '#bfdbfe',
            lineColor: '#bfdbfe',
            textColor: '#ffffff',
            nodeTextColor: '#ffffff',
            tertiaryColor: '#1d4ed8',
        },
    });

    async function renderMermaidDiagrams() {
        const codeBlocks = document.querySelectorAll<HTMLElement>('.project-body pre[data-language="mermaid"] code');

        for (const [index, codeBlock] of codeBlocks.entries()) {
            const pre = codeBlock.closest('pre');
            if (!pre) return;

            const diagram = document.createElement('div');
            diagram.className = 'mermaid';
            const definition = codeBlock.textContent || '';
            const { svg } = await mermaid.render(`project-diagram-${index}`, definition);
            diagram.innerHTML = svg;
            pre.replaceWith(diagram);
        }
    }

    renderMermaidDiagrams();
</script>

<style is:global>
    .project-body h2 {
        font-family: 'Fraktion Sans', sans-serif;
        font-size: clamp(1.75rem, 1.6966rem + 0.2671vw, 1.953rem);
        line-height: 1.15;
        margin-top: 3rem;
        margin-bottom: 1rem;
    }

    .project-body p,
    .project-body li {
        font-family: 'Fraktion Sans', sans-serif;
        font-size: 1.125rem;
        line-height: 1.65;
        opacity: 0.82;
    }

    .project-body p + p,
    .project-body ul,
    .project-body pre {
        margin-top: 1rem;
    }

    .project-body ul {
        list-style: disc;
        padding-left: 1.25rem;
    }

    .project-body pre {
        overflow-x: auto;
        border: 1px solid rgb(255 255 255 / 0.2);
        border-radius: 0.5rem;
        padding: 1rem;
        background: rgb(255 255 255 / 0.08);
    }

    .project-body code {
        font-family: 'Fraktion Mono', monospace;
        font-size: 0.9em;
    }

    .project-body .mermaid {
        margin-top: 1.5rem;
        overflow-x: auto;
        border: 1px solid rgb(255 255 255 / 0.2);
        border-radius: 0.5rem;
        padding: 1rem;
        background: rgb(255 255 255 / 0.08);
    }

    .project-body .mermaid svg {
        max-width: 100%;
        height: auto;
    }
</style>
