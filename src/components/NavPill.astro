<div id="nav-wrapper">
  <nav id="nav-pill">
    <a href="#work">Work</a>
    <span>/</span>
    <a href="#cv">CV</a>
    <span>/</span>
    <a href="#contact">Contact</a>
  </nav>
</div>

<style>
  #nav-wrapper {
    position: fixed;
    bottom: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    perspective: 800px;
    z-index: 50;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background-color: rgb(17, 24, 39);
    padding: 1rem 3.6rem;
    border-radius: 9999px;
    font-family: 'Fraktion Sans', sans-serif;
    font-size: 0.84rem;
    transform-style: preserve-3d;
    transition: transform 0.1s ease;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    opacity: 1;
  }

  @media (max-width: 400px) {
    nav {
      padding: 0.85rem 2rem;
      font-size: 0.78rem;
      gap: 0.5rem;
    }
  }

  @media (orientation: landscape) and (max-height: 600px) {
    #nav-wrapper {
      bottom: 0.5rem;
    }
    nav {
      padding: 0.7rem 2.4rem;
      font-size: 0.78rem;
    }
  }
</style>

<script>
  const pill = document.getElementById('nav-pill');

  pill?.addEventListener('mousemove', (e) => {
    const rect = pill.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const centerX = rect.width / 2;

    const rotateZ = ((x - centerX) / centerX) * 1;
    pill.style.transform = `rotateZ(${rotateZ}deg)`;
  });

  pill?.addEventListener('mouseleave', () => {
    pill.style.transition = 'transform 0.4s ease';
    pill.style.transform = 'rotateZ(0deg)';
  });

  window.addEventListener('scroll', () => {
    if (!pill) return;

    const scrolled = window.scrollY;
    const total = document.body.scrollHeight - window.innerHeight;
    const progress = total > 0 ? (scrolled / total) * 100 : 0;

    pill.style.background = `linear-gradient(to right, rgb(38, 45, 61) ${progress}%, rgb(15, 20, 39) ${progress}%)`;
  });

</script>