---
import PortfolioTerminal from '../components/PortfolioTerminal/PortfolioTerminal.jsx';

const description = "Priyan Arora is a computer science student and software developer in Fredericton, New Brunswick, building projects with React, Astro, Next.js, TypeScript, Java, Node.js, Spring Boot, D3.js, GIS, AWS, and Supabase.";
const keywords = [
  "Priyan Arora",
  "Priyan Arora terminal portfolio",
  "software engineer Fredericton",
  "software developer Fredericton",
  "co-op Fredericton",
  "software developer co-op Fredericton",
  "Atlantic software engineer",
  "Atlantic Canada software engineer",
  "Atlantic software developer",
  "New Brunswick software developer",
  "University of New Brunswick computer science",
  "UNB computer science",
  "PRPilot",
  "Auctus",
  "D3Careers",
  "BSI Solutionz",
  "EVLOS-OPS",
  "Likit",
  "React",
  "Astro",
  "Next.js",
  "TypeScript",
  "JavaScript",
  "Java",
  "Node.js",
  "Express",
  "Spring Boot",
  "D3.js",
  "Tailwind CSS",
  "MongoDB",
  "PostgreSQL",
  "Supabase",
  "DynamoDB",
  "AWS Lambda",
  "Docker",
  "ArcGIS",
  "GIS developer",
].join(", ");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Priyan Arora" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="priyan@portfolio — bash" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Priyan Arora Portfolio" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="priyan@portfolio — bash" />
    <meta name="twitter:description" content={description} />
    <title>priyan@portfolio — bash</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <PortfolioTerminal client:load />
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; background: #1d0d2e; }
</style>
