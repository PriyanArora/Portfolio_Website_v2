---
import BaseLayout from '@/layouts/BaseLayout.astro'; 
import Header from '@/components/Header.astro';
import NavPill from '@/components/NavPill.astro';
import { getCollection } from 'astro:content';  
import profileData from '../../content/data/profile.json';  

const allProjects = await getCollection('projects');
const placeholderThumbnail = '/thumbnails/placeholder.png';
  const featured = allProjects                                                                                                                                                  
      .filter(p => p.data.featured)                                                                                                                                           
      .sort((a, b) => a.data.order - b.data.order);  
---
<BaseLayout>
    <Header />
    <NavPill />
    <main class="max-w-screen-2xl mx-auto">
        <section id="hero" class="min-h-screen flex items-start px-6 lg:px-11 pt-[21vh]">
            <div>
                <h1 class="hero-title col-span-12 lg:col-span-10 font-sans text-3xl xs:text-5xl sm:text-5xl md:text-6xl lg:text-[6rem] 3xl:text-[6.8rem] leading-none tracking-tight">
                    Priyan Arora (b. 2006). Computer science student who spends his time pushing pixels and writing code for screens.
                </h1>
            </div>
        </section>
        <section id="work" class="lg:min-h-screen px-6 lg:px-16 py-12 lg:py-20">
              <div class="flex items-center gap-3 font-mono text-sm mb-8 lg:mb-12">                                                                                                                              
                  <span><b>Featured Work</b></span>
                  <span class="spin-line"></span>                                                                                                                                  
              </div>                                                                                                                                                            
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">                                                                                                               
                  {featured.map(project => (
                      <article class="project-card group block">                                                                              
                            {project.data.video ? (
                                <div class="project-video">
                                    <video
                                        autoplay
                                        muted
                                        loop
                                        playsinline
                                        preload="metadata"
                                    >
                                        <source src={project.data.video} type="video/mp4" />
                                    </video>
                                </div>
                            ) : project.data.thumbnail !== placeholderThumbnail ? (
                                <div class={`project-media project-media-${project.data.slug}`}>
                                    <img src={project.data.thumbnail} alt="" decoding="async" />
                                </div>
                            ) : (
                                <div class="aspect-video bg-white/10 rounded mb-4"></div>
                            )}
                            <div class="project-title-row mb-1">
                                <p class="project-title font-sans text-xl underline decoration-blue-500 underline-offset-4 transition-colors group-hover:decoration-blue-200">
                                    {project.data.title}
                                </p>
                                {(project.data.repoUrl || project.data.liveUrl) && (
                                    <div class="project-link-row" role="group" aria-label={`${project.data.title} links`}>
                                        {project.data.repoUrl && (
                                            <a
                                                class="project-icon-link"
                                                href={project.data.repoUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${project.data.title} GitHub repository`}
                                            >
                                                <img src="/github_logo.png" alt="" decoding="async" />
                                            </a>
                                        )}
                                        {project.data.liveUrl && (
                                            <a
                                                class="project-icon-link"
                                                href={project.data.liveUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${project.data.title} external link`}
                                            >
                                                <img src="/link-icon.svg" alt="" decoding="async" />
                                            </a>
                                        )}
                                    </div>
                                )}
                            </div>
                            <p class="font-sans text-sm opacity-60">{project.data.description}</p>
                      </article>                                                                                                                                                      
                  ))}                                                                                                                                                           
              </div>                                                                                                                                                            
          </section>  
        <section id="cv" class="px-6 lg:px-16 py-12 lg:pt-20 lg:pb-12">
            <div class="flex items-center gap-3 font-mono text-sm mb-8 lg:mb-12">                                                                                                             
                <span><b>Elevator Pitch</b></span>                                                                                                                                    
                <span class="spin-line"></span>
            </div>                                                                                                                                                                    
            <div class="max-w-4xl">
                    <p class={`font-sans text-2xl xs:text-3xl md:text-4xl leading-snug`}>
                        {profileData.elevatorPitch[0]}
                        <br><br>
                    <b>Open for new opportunities</b> and for making new connections. <a href="mailto:priyanarora22@gmail.com">Reach out</a> if you want to chat about anything!
                    </p>
            </div>      
        </section>
         <section id="skills" class="px-6 lg:px-16 py-12 lg:pt-20 lg:pb-12">
            <div class="flex items-center gap-3 font-mono text-sm mb-8 lg:mb-12">
                <span><b>Skills</b></span>
                <span class="spin-line"></span>
            </div>
            <div class="flex flex-col gap-8">
                {profileData.skills.map(group => (
                    <div>
                        <p class="font-mono text-sm opacity-60 mb-2">{group.category}</p>
                        <p class="font-sans text-xl">{group.items.join(' / ')}</p>
                    </div>
                ))}
            </div>
        </section>
        <section id="certifications" class="px-6 lg:px-16 py-12 lg:pt-20 lg:pb-12">
            <div class="flex items-center gap-3 font-mono text-sm mb-8 lg:mb-12">
                <span><b>Certifications</b></span>                                                                                                                                         
                <span class="spin-line"></span>
            </div>                                                                                                                                                                    
            <div>                                                                                                                                                                   
                {profileData.certifications.map((certification) => (
                    <p class="font-sans text-xl">
                        <a href={certification.url} target="_blank" rel="noopener noreferrer" class="certification-link">
                            {certification.name}
                        </a>
                    </p>
                ))}         
            </div>                                                                                                                                                                    
        </section> 
        <section id="contact" class="px-6 lg:px-16 py-12 lg:py-20 pb-24 lg:pb-48">
            <div class="flex items-center gap-3 font-mono text-sm mb-8 lg:mb-12">                                                                                                             
                <span><b>Get in Touch</b></span>
                <span class="spin-line"></span>                                                                                                                                       
            </div>                                                                                                                                                                    
            <p class="font-sans text-2xl xs:text-3xl md:text-4xl">
                Find me on <a href={profileData.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> or <a href={profileData.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>. Or just <a href="mailto:priyanarora22@gmail.com">send an email</a>.                                                                                                                      
            </p>                                                                                                                                                                      
        </section>        
    </main>
    <script>
        import gsap from 'gsap';                                                                                                                                                      
        import { SplitText } from 'gsap/SplitText'; 
        gsap.registerPlugin(SplitText);

        window.addEventListener('DOMContentLoaded', () => {
            const heroTitle = document.querySelector('.hero-title');
            if (!heroTitle) return;

            const split = new SplitText('h1', { type: 'words' });

            gsap.set(split.words, {
                y: 40,
                opacity: 0
            });

            gsap.set(heroTitle, {
                visibility: 'visible'
            });

            gsap.to(split.words, {
                y: 0,
                opacity: 1,
                duration: 1.4,
                stagger: 0.07,
                ease: 'power3.out'
            });

            gsap.to('#header', {
                y: '0%',
                duration: 1,
                delay: 1.4,
                ease: 'power4.out'
            });
        });

    </script>
    <style>
        .hero-title {
        visibility: hidden;
        }

        .project-media,
        .project-video {
            aspect-ratio: 2 / 1;
            width: 100%;
            overflow: hidden;
            border-radius: 0.25rem;
            margin-bottom: 1rem;
            background: rgb(255 255 255 / 0.1);
        }

        .project-media {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .project-video video {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
        }

        .project-media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .project-media-project-1 {
            background: #222226;
        }

        .project-media-project-5 {
            background: #ffffff;
            border: 1px solid #ffffff;
        }

        .project-media-project-5 img {
            object-fit: cover;
            object-position: 54% 44%;
            transform: scale(1.55);
            transform-origin: 54% 44%;
        }

        .project-media-project-6 {
            background: #222226;
        }

        .project-media-project-1 img,
        .project-media-project-6 img {
            width: 50%;
            height: 50%;
        }

        .project-title-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1.5rem;
            font-size: 1.25rem;
            line-height: 1.75rem;
        }

        .project-title {
            min-width: 0;
            margin: 0;
        }

        .project-link-row {
            display: flex;
            flex: 0 0 auto;
            align-items: flex-end;
            justify-content: flex-end;
            gap: 0.5rem;
            margin-left: auto;
        }

        .project-icon-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            padding-bottom: 0.18em;
            border-bottom: 1.5px solid transparent;
            text-decoration: none;
            transition: border-color 150ms ease;
        }

        .project-icon-link:hover {
            border-bottom-color: #BFDBFE;
            text-decoration: none;
        }

        .project-icon-link img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .certification-link {
            display: inline-block;
            border-bottom: 1.5px solid transparent;
            text-decoration: none;
            transition: border-color 150ms ease;
        }

        .certification-link:hover {
            border-bottom-color: #BFDBFE;
            text-decoration: none;
        }

        @media (max-width: 420px) {
            .project-title-row {
                gap: 1rem;
            }

            .project-link-row {
                gap: 0.45rem;
            }
        }
    </style>
   
</BaseLayout>
